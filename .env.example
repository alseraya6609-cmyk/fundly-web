# اختياري: إن تُركا فارغين يُستعمل مشروع Supabase نفسه الذي يستعمله التطبيق.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# اختياري: إشعارات والموقع مغلق (Web Push). تطبيق ويب في مشروع Firebase نفسه
# الذي يرسل منه التطبيق (قيم عامة لا أسرار)، ومفتاح Web Push من Cloud Messaging.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
